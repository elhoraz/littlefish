# Supabase PostgreSQL Configuration (Prisma + Connection Pooling for Vercel)
# DATABASE_URL: Transaction pooler port 6543 (used by app runtime in serverless)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Direct session port 5432 (used by Prisma migrations and db push)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentication secret
JWT_SECRET="your-secure-random-secret-key-min-32-chars"

# App Settings
NEXT_PUBLIC_APP_NAME="Bimbel Littlefish"
UPLOAD_DIR="./uploads"
